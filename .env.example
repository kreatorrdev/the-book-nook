# Leave unset for a persistent, embedded PostgreSQL database in .data/.
# Use a standard PostgreSQL/Neon connection string for a hosted deployment.
# DATABASE_URL=postgresql://booknook:booknook@localhost:5432/booknook
BETTER_AUTH_URL=http://localhost:3000
# Required in production. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
BETTER_AUTH_SECRET=
