{
  "name": "the-book-nook",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "prebuild": "node scripts/check-assets.mjs",
    "build": "next build --webpack",
    "build:vercel": "node scripts/check-vercel-env.mjs && npm run build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "tsx tests/integration.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "assets": "tsx scripts/covers.ts",
    "test:production": "node scripts/verify-production.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "latest",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@tailwindcss/postcss": "latest",
    "better-auth": "latest",
    "drizzle-orm": "latest",
    "lucide-react": "latest",
    "next": "16.4.2",
    "pg": "latest",
    "react": "latest",
    "react-dom": "latest",
    "tailwindcss": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/pg": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "latest"
  },
  "engines": {
    "node": ">=22"
  }
}
